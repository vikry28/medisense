# Copy to .env and change every secret before exposing this stack.
POSTGRES_USER=medisense
POSTGRES_PASSWORD=medisense
POSTGRES_DB=medisense
POSTGRES_PORT=5433

MQTT_PORT=1883
MQTT_TLS_PORT=8883
MQTT_BACKEND_PASSWORD=backend-secret
MQTT_DEVICE_001_PASSWORD=device-secret-001
MQTT_DEVICE_002_PASSWORD=device-secret-002

BACKEND_PORT=3000
LOG_LEVEL=info
CORS_ORIGINS=*

JWT_ACCESS_SECRET=dev-access-secret-change-me-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30
PAIRING_CODE_PEPPER=dev-pairing-pepper-change-me
PAIRING_CODE_TTL_MINUTES=15
PAIRING_ALLOW_DEVICE_CODE=true

EMAIL_OTP_PEPPER=dev-email-otp-pepper-change-me
EMAIL_OTP_TTL_MINUTES=10
EMAIL_OTP_MAX_ATTEMPTS=5
EMAIL_OTP_RESEND_COOLDOWN_SECONDS=60

MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
SMTP_FROM=MediSense <no-reply@medisense.local>

DEVICE_OFFLINE_THRESHOLD_SECONDS=90
DEVICE_SWEEPER_INTERVAL_MS=30000
