# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
CORS_ORIGINS=*
LOG_LEVEL=info
SWAGGER_ENABLED=true

# PostgreSQL (Prisma)
DATABASE_URL=postgresql://medisense:medisense@localhost:5433/medisense?schema=public

# Auth
JWT_ACCESS_SECRET=change-me-to-a-random-string-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30
JWT_ISSUER=medisense
JWT_AUDIENCE=medisense-app

# Device pairing
PAIRING_CODE_PEPPER=change-me-pairing-pepper-at-least-16-chars
PAIRING_CODE_TTL_MINUTES=15
PAIRING_ALLOW_DEVICE_CODE=true

# Email verification
EMAIL_OTP_PEPPER=change-me-email-otp-pepper-at-least-16-chars
EMAIL_OTP_TTL_MINUTES=10
EMAIL_OTP_MAX_ATTEMPTS=5
EMAIL_OTP_RESEND_COOLDOWN_SECONDS=60

# Mail delivery: "console" logs the OTP, "smtp" sends a real email
MAIL_TRANSPORT=console
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=MediSense <no-reply@medisense.local>

# MQTT
MQTT_ENABLED=true
# Use mqtts://host:8883 to connect over TLS (recommended).
MQTT_URL=mqtt://localhost:1883
MQTT_USERNAME=medi-backend
MQTT_PASSWORD=backend-secret
MQTT_CLIENT_ID=medisense-backend
MQTT_TOPIC_PREFIX=medisense
MQTT_REJECT_UNAUTHORIZED=true
# TLS material; required when MQTT_URL uses mqtts:// and the broker uses a
# private CA. Leave empty for plaintext local development.
MQTT_CA_PATH=
MQTT_CERT_PATH=
MQTT_KEY_PATH=

# Device presence
DEVICE_OFFLINE_THRESHOLD_SECONDS=90
DEVICE_SWEEPER_INTERVAL_MS=30000

# Seed / demo credentials (development only)
SEED_DEMO_EMAIL=demo@medisense.local
SEED_DEMO_PASSWORD=Demo1234!
SEED_DEVICE_PAIRING_CODE=123456
